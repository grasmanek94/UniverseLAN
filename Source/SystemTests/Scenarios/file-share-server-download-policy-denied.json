{
  "name": "file-share-server-download-policy-denied",
  "runtimeProvider": "universelan",
  "timeoutSeconds": 30,
  "server": {
    "enabled": true,
    "readyEvent": "server-ready",
    "configuration": {
      "maxConnections": 4,
      "allowFileSharingDownload": false,
      "allowFileSharingUpload": true
    }
  },
  "hosts": [
    {
      "role": "storage-client",
      "scenario": "file-share-server-download-policy-denied",
      "identity": {
        "userId": 2503,
        "personaName": "FileShareDownloadPolicyClient"
      },
      "waitFor": ["server-ready"],
      "timeoutSeconds": 20
    }
  ]
}
